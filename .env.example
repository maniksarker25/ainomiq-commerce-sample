# ============================================================================
# ainomiq Commerce — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# All secrets must live here or in Vercel Project Settings, never in source.
# ============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --- Database (Turso / libSQL) ---------------------------------------------
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- Optional Supabase backend (leave empty to use Turso only) -------------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Security ---------------------------------------------------------------
# 32-byte key, hex (64 chars) or base64. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# JWT signing secret. Generate: openssl rand -hex 48
JWT_SECRET=
AINOMIQ_SESSION_COOKIE=ainomiq_session
# Password for the pre-launch "coming soon" gate
COMING_SOON_PASSWORD=123456
# Bearer secret for cron endpoints (also set in Vercel cron config)
CRON_SECRET=
# Temporary migration switch only — keep OFF in production
ALLOW_PLAINTEXT_TOKEN_FALLBACK=false

# --- Default tenant (single-tenant/dev convenience) ------------------------
DEFAULT_TENANT_ID=
AINOMIQ_TENANT_ID=
AINOMIQ_INVITE_EMAIL=
AINOMIQ_BASE_URL=

# --- AI providers (OpenRouter primary, others optional) --------------------
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=
GOOGLE_API_KEY=
# Per-feature model overrides (optional)
AD_STRATEGIST_MODEL=
CONTENT_AGENT_MODEL=
CONTENT_ANALYSIS_MODEL=
CONTENT_TRAINING_MODEL=
SUPPORT_CHAT_MODEL=

# --- Google OAuth (Gmail / Drive) ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Meta / Instagram (Ads + webhooks) -------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_AUTO_REPLY=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Shopify ----------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_APP_STORE_URL=

# --- Klaviyo ----------------------------------------------------------------
KLAVIYO_API_KEY=

# --- Twilio (voice + SMS) ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REGION=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_STATUS_WEBHOOK_URL=
TWILIO_SMS_WEBHOOK_URL=
VOICE_RELAY_URL=
VOICE_RELAY_PORT=

# --- Cloudflare R2 / S3 storage --------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CREATIVE_LIBRARY_R2_BUCKET=
CREATIVE_LIBRARY_SUPABASE_BUCKET=
CREATIVE_LIBRARY_PUBLIC_URL=
CREATIVE_LIBRARY_MAX_FILE_BYTES=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=

# --- Misc / feature flags ---------------------------------------------------
NEXT_PUBLIC_SHOW_LEGACY_SUPPORT=false
LATEDEV_API_KEY=
LATEDEV_ACCOUNT_ID=
